# Base de datos (Prisma + SQLite por defecto)
DATABASE_URL="file:./database.db"

PORT=4000
NODE_ENV=development

# Clave para firmar los JWT de sesión. Generar una propia en producción:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# Origen del cliente autorizado para CORS (separar con comas si hay varios)
CLIENT_URL=http://localhost:5173

# Credenciales OAuth 2.0 obtenidas en Google Cloud Console.
# El GOOGLE_CLIENT_ID debe ser el mismo que usa el cliente en VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Si es true, un usuario de Google que no exista en la base se registra
# automáticamente como POSTULANTE en estado pendiente de validación.
# En producción debe quedar en false.
ALLOW_GOOGLE_AUTO_REGISTER=false

# Habilita POST /api/auth/dev-login. Solo tiene efecto con NODE_ENV=development.
# Cualquier otro entorno con este flag en true impide arrancar el servidor.
ALLOW_DEV_LOGIN=false

# Secreto del webhook de cola virtual (header x-queue-webhook-secret).
# Si está vacío, POST /api/webhooks/queue responde 401.
QUEUE_WEBHOOK_SECRET=
